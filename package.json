{
  "name": "wedfotobook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run db:migrate && next dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/prepare-home-css.mjs && next build",
    "start": "node scripts/server.mjs",
    "start:vps": "bash scripts/start-vps.sh",
    "check:contact-config": "node scripts/check-contact-config.mjs .env.local",
    "setup:local-mailer": "bash scripts/install-local-mailer.sh",
    "check:assets": "node scripts/check-public-assets.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-sqlite.mjs .env.local"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
