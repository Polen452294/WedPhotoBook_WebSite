# Email notifications (the enquiry is still saved to D1 when email is unavailable)
RESEND_API_KEY=
CONTACT_TO_EMAIL=79854342367@yandex.ru
CONTACT_FROM_EMAIL=Wedfotobook <orders@your-verified-domain.ru>

# Cloudflare Turnstile. Configure both values from the same Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADOYhKhruVUymxia
TURNSTILE_SECRET_KEY=

# Use a long random value to pseudonymize rate-limit identifiers.
RATE_LIMIT_SALT=

# App-owned admin login: generate a PBKDF2 hash with `node scripts/hash-admin-password.mjs`.
ADMIN_PASSWORD_HASH=

# Independent random values of at least 32 bytes. Never reuse them elsewhere.
ADMIN_SESSION_SECRET=
ADMIN_LOGIN_SALT=

# Optional internal audit identity. Neither value is requested on the login page.
ADMIN_DISPLAY_NAME=Администратор
ADMIN_ACCOUNT_EMAIL=admin@localhost

# Optional fallback for a Cloudflare Sites deployment using Sign in with ChatGPT.
ADMIN_EMAILS=

# A separate long random value used only to pseudonymize admin audit metadata.
ADMIN_AUDIT_SALT=

# Set to 1 only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY_ORIGIN=0
